{
  "rules": {
    ".read": false,
    ".write": false,
    "rooms": {
      "$code": {
        ".read": false,
        ".write": false,
        "members": {
          ".read": "auth != null && data.child(auth.uid).exists() && root.child('rooms').child($code).child('server').child('expiresAt').val() > now",
          ".write": false
        },
        "public": {
          ".read": "auth != null && root.child('rooms').child($code).child('members').child(auth.uid).exists() && root.child('rooms').child($code).child('server').child('expiresAt').val() > now",
          ".write": false
        },
        "private": {
          "$uid": {
            ".read": "auth != null && auth.uid === $uid && root.child('rooms').child($code).child('members').child(auth.uid).exists() && root.child('rooms').child($code).child('server').child('expiresAt').val() > now",
            ".write": false
          }
        },
        "server": {
          ".read": false,
          ".write": false
        }
      }
    },
    "presence": {
      "$code": {
        ".read": "auth != null && root.child('rooms').child($code).child('members').child(auth.uid).exists() && root.child('rooms').child($code).child('server').child('expiresAt').val() > now",
        "$uid": {
          "$connId": {
            ".write": "auth != null && auth.uid === $uid && (!newData.exists() || (root.child('rooms').child($code).child('members').child(auth.uid).exists() && root.child('rooms').child($code).child('server').child('expiresAt').val() > now && root.child('rooms').child($code).child('public').child('phase').val() !== 'CLOSED'))",
            ".validate": "newData.val() === true && $connId.matches(/^[a-zA-Z0-9_-]{1,64}$/)"
          }
        }
      }
    }
  }
}
